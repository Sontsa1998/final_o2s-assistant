# ---------- Proxy LiteLLM ----------
# À copier en `.env` (ou `env`) à la racine. Noms alternatifs acceptés :
# OPENAI_BASE_URL / LITELLM_URL et OPENAI_API_KEY. « /v1 » est ajouté automatiquement.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-votre-cle-litellm

# Noms des modèles tels que déclarés dans le config.yaml de LiteLLM (model_name)
MODEL_GENERATION=claude-sonnet-5
MODEL_REASONING=gpt-5.1
MODEL_FAST=gpt-5-mini
MODEL_PROFILING=claude-sonnet-5
MODEL_EMBEDDING=text-embedding-3-large
EMBEDDING_DIM=3072

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=o2s_docs_v4
ENABLE_SPARSE=true

# ---------- Réseau ----------
# Derrière le proxy d'entreprise (erreur « CERTIFICATE_VERIFY_FAILED / self-signed certificate ») :
# SSL_VERIFY=false désactive la vérification TLS (LiteLLM, Qdrant, Hugging Face). Poste de dev uniquement.
# SSL_VERIFY=false

# ---------- Indexation ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=100
PARENT_HEADING_LEVELS=3
ENABLE_LLM_ENRICHMENT=true

# ---------- Cache local des appels LLM / embeddings ----------
# Réponses mises en cache par empreinte (modèle + prompt + contenu) : profilage, enrichissement,
# intention, rerank et embeddings. Désactivable ponctuellement avec `--no-cache` (o2s-index, o2s-profile).
LLM_CACHE_ENABLED=true
# LLM_CACHE_PATH=data/cache/llm_cache.sqlite

# ---------- Recherche / rerank ----------
SEARCH_TOP_K=20
RERANK_TOP_N=6
RERANK_MIN_SCORE=0.35
RERANKER_BACKEND=llm
CONTEXT_STRATEGY=parent_if_small

# ---------- Agent ----------
# local = search/rerank in-process (dev) ; http = appels aux microservices (docker)
SERVICES_MODE=local
MAX_RETRIEVAL_ATTEMPTS=2
CHECKPOINTER=sqlite
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/o2s
ENABLE_MCP=false
LOG_LEVEL=INFO
